{
  "name": "@falak/notebook-web",
  "version": "0.0.0",
  "private": true,
  "description": "Notebook front end (React). Uses the client generated by `falak sync`.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "sync": "cargo run -q -p falak-cli -- sync .. --out src/falak.generated.ts",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@falak/sdk": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  }
}
